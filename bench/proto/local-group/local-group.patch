+//! A local peer's group without a Raft log (docs/architecture.md D2, first step).
+//!
+//! A single-member group gains nothing from a replicated log: openraft writes
+//! each entry to the log database, then applies it to the state machine
+//! database, two redb write transactions per command. Here one thread applies
+//! commands straight to the state machine in one transaction per batch of
+//! concurrent proposals. The commit is `Durability::Immediate` on the local
+//! peer's no-sync backend, so it survives the peer process dying, which is the
+//! guarantee the Raft log gave a local peer.
+//!
+//! Replies go out after the commit and events after the replies, as in
+//! `StateMachine::apply`.
+
+use crate::log_store::io_err;
+use crate::state_machine::{GroupEvents, SM, apply_cmd};
+use chimaera_core::pb;
+use chimaera_core::shard::ShardState;
+use redb::{Database, Durability};
+use std::io;
+use std::sync::Arc;
+use std::sync::mpsc;
+use tokio::sync::oneshot;
+
+/// Commands applied in one transaction at most.
+const MAX_BATCH: usize = 1024;
+
+type Proposal = (pb::ShardCmd, oneshot::Sender<Result<pb::ShardReply, String>>);
+
+pub(crate) struct Applier {
+    tx: mpsc::Sender<Proposal>,
+}
+
+impl Applier {
+    pub(crate) fn start(
+        group: u32,
+        db: Arc<Database>,
+        events: tokio::sync::mpsc::Sender<GroupEvents>,
+    ) -> io::Result<Applier> {
+        let (tx, rx) = mpsc::channel::<Proposal>();
+        std::thread::Builder::new().name(format!("apply-{group}")).spawn(move || run(group, &db, &events, &rx))?;
+        Ok(Applier { tx })
+    }
+
+    pub(crate) async fn propose(&self, cmd: pb::ShardCmd) -> Result<pb::ShardReply, String> {
+        let (tx, rx) = oneshot::channel();
+        self.tx.send((cmd, tx)).map_err(|_| "local applier stopped".to_string())?;
+        rx.await.map_err(|_| "local applier stopped".to_string())?
+    }
+}
+
+fn run(group: u32, db: &Database, events: &tokio::sync::mpsc::Sender<GroupEvents>, rx: &mpsc::Receiver<Proposal>) {
+    let shard = ShardState::new();
+    while let Ok(first) = rx.recv() {
+        let mut batch = vec![first];
+        while batch.len() < MAX_BATCH {
+            match rx.try_recv() {
+                Ok(p) => batch.push(p),
+                Err(_) => break,
+            }
+        }
+        match apply(db, group, &shard, &batch) {
+            Ok((replies, evs)) => {
+                for ((_, tx), reply) in batch.into_iter().zip(replies) {
+                    let _ = tx.send(Ok(reply));
+                }
+                if !evs.is_empty() {
+                    // A dropped receiver means the peer is shutting down; state is committed.
+                    let _ = events.blocking_send(GroupEvents { group, events: evs });
+                }
+            }
+            Err(e) => {
+                let msg = e.to_string();
+                for (_, tx) in batch {
+                    let _ = tx.send(Err(msg.clone()));
+                }
+            }
+        }
+    }
+}
+
+fn apply(
+    db: &Database,
+    group: u32,
+    shard: &ShardState,
+    batch: &[Proposal],
+) -> io::Result<(Vec<pb::ShardReply>, Vec<chimaera_core::shard::Event>)> {
+    let mut txn = db.begin_write().map_err(io_err)?;
+    txn.set_durability(Durability::Immediate).map_err(io_err)?;
+    let mut replies = Vec::with_capacity(batch.len());
+    let mut events = Vec::new();
+    {
+        let mut table = txn.open_table(SM).map_err(io_err)?;
+        for (cmd, _) in batch {
+            let (reply, evs) = apply_cmd(&mut table, group, shard, cmd);
+            replies.push(reply);
+            events.extend(evs);
+        }
+    }
+    txn.commit().map_err(io_err)?;
+    Ok((replies, events))
+}

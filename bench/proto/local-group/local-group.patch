+    #[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+    async fn replies_survive_the_process_dying() {
+        let dir = tempfile::tempdir().unwrap();
+        let status = std::process::Command::new(std::env::current_exe().unwrap())
